# ============================================================
# Le Rasa Bakery — Supabase environment
# Copy to .env.local and fill in. .env.local is gitignored.
# ============================================================

# Public — safe to expose to the browser. RLS protects these.
# The anon key is now the "publishable" key (new format: sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Server-only — NEVER prefix with NEXT_PUBLIC_. Bypasses RLS.
# Used only by lib/supabase/server.ts (API routes / server actions).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Project ref, used by `npm run gen:types`. Just the ref, e.g. hvtjylewfrneoviwzxuk
SUPABASE_PROJECT_REF=<project-ref>

# Stripe — customer checkout. pk_ is browser-safe; sk_ is server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key>
STRIPE_SECRET_KEY=<stripe-secret-key>
# Webhook signing secret for /api/stripe/webhook — the safety net that recovers
# an order when the customer's browser never saved it. Locally:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# and copy the whsec_… it prints.
STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>

# Cron — 24h auto-cancel sweep, triggered by an EXTERNAL scheduler (cron-job.org
# et al) calling /api/cron/auto-cancel with `Authorization: Bearer <CRON_SECRET>`.
# No vercel.json cron. Without this the endpoint 401s every request and Pending
# orders are never cancelled. Random string, 16+ chars.
CRON_SECRET=<random-16-plus-chars>
