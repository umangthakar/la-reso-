# ============================================================
# Le Rasa Bakery — Supabase environment
# Copy to .env.local and fill in. .env.local is gitignored.
# ============================================================

# Public — safe to expose to the browser. RLS protects these.
# The anon key is now the "publishable" key (new format: sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Server-only — NEVER prefix with NEXT_PUBLIC_. Bypasses RLS.
# Used only by lib/supabase/server.ts (API routes / server actions).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Project ref, used by `npm run gen:types`. Just the ref, e.g. hvtjylewfrneoviwzxuk
SUPABASE_PROJECT_REF=<project-ref>

# Stripe — customer checkout. pk_ is browser-safe; sk_ is server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key>
STRIPE_SECRET_KEY=<stripe-secret-key>

# Cron — 24h auto-cancel sweep, run hourly (vercel.json `0 * * * *`; an hourly
# cron needs Vercel Pro). Vercel only sends its Authorization header when this
# is set; without it every sweep 401s and Pending orders are never cancelled.
# Random string, 16+ chars. Also usable as ?secret=<value> to trigger by hand.
CRON_SECRET=<random-16-plus-chars>
