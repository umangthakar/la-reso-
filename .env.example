# ============================================================
# Environment variables — copy to .env.local and fill in.
# .env.local is gitignored. Configure these in Vercel as well.
# ============================================================

# Public — exposed to the browser. Protected by Supabase RLS.
# The anon key is now the "publishable" key (new format: sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Key for encrypting admin secrets at rest (e.g. the Stripe secret key stored
# from the admin panel). Use a long random string. STRONGLY recommended in
# production: without it the encryption key IS the service-role key, so
# rotating that would strand every stored secret.
# Safe to add to a live site at any time — secrets encrypted before it was set
# are still decrypted with the old key automatically (see lib/crypto.ts), and
# re-saving one in the admin panel re-encrypts it under this key.
ADMIN_ENCRYPTION_KEY=

# Server-only admin gate password. Validated by /api/admin/login; the
# value never reaches the browser. Set a strong password in production.
ADMIN_PASSWORD=

# Optional — admin login email. When set, the admin sign-in additionally
# requires this exact address (case-insensitive). Leave blank to accept any
# valid email alongside ADMIN_PASSWORD (backward compatible).
ADMIN_EMAIL=

# Optional — Supabase project ref, used only by `npm run gen:types`.
SUPABASE_PROJECT_REF=

# Stripe — customer checkout payments.
# Publishable key is exposed to the browser; secret key is server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Signing secret for POST /api/stripe/webhook (Stripe Dashboard → Developers →
# Webhooks → your endpoint → "Signing secret", or `stripe listen` locally).
# Without it the endpoint rejects every delivery, so a payment whose browser
# never saved the order is NOT recovered. Required in production.
# Subscribe the endpoint to: payment_intent.succeeded,
# payment_intent.payment_failed, charge.refunded, refund.updated,
# checkout.session.completed.
STRIPE_WEBHOOK_SECRET=

# Email (Resend) — owner notifications for custom cake inquiries.
# Without RESEND_API_KEY, sends are skipped (best-effort; never blocks a save).
RESEND_API_KEY=
# Where owner notifications are delivered. If unset, falls back to the
# site_settings contact email.
OWNER_EMAIL=
# Verified "From" address. The domain MUST be verified in Resend, otherwise
# Resend rejects the send (403). Defaults to Resend's test sender if unset.
# Example: Le Rasa <info@lerasa.co.uk>
EMAIL_FROM=
# Optional — bakery WhatsApp number (digits only), available to callers.
OWNER_WHATSAPP=

# Auth Email module (lib/auth-email.ts) — live; sends the verification,
# reset, welcome and password-changed emails via Resend.
# Requires RESEND_API_KEY (above). All of the following are OPTIONAL:
# "From" for auth emails; falls back to EMAIL_FROM, then Resend's test sender.
AUTH_EMAIL_FROM=
# Optional Reply-To for auth emails.
AUTH_EMAIL_REPLY_TO=
# Customer-facing support address shown in auth email footers; falls back to
# AUTH_EMAIL_REPLY_TO, then to Info.lerasa@gmail.com (lib/email-brand).
# NOT OWNER_EMAIL — that inbox is internal and is never shown to a customer.
AUTH_SUPPORT_EMAIL=
# Absolute site origin used to build links (verify/reset/welcome).
# Falls back to SITE_URL. No trailing slash. e.g. https://lerasa.co.uk
NEXT_PUBLIC_SITE_URL=
SITE_URL=
# Brand name shown in email headers/footers. Defaults to "Le Rasa"
# (lib/email-brand.EMAIL_BRAND).
NEXT_PUBLIC_BRAND_NAME=

# ntfy push — instant "New Order Received" push to the owner's phone (SERVER
# ONLY; never prefix with NEXT_PUBLIC_). Both must be set or the push is
# skipped. NTFY_URL is the ntfy server base (no trailing slash); NTFY_TOPIC is
# the subscribed topic. e.g. https://ntfy.sh + lerasa-orders-<random>
NTFY_URL=
NTFY_TOPIC=

# Cron — 24h auto-cancel sweep (/api/cron/auto-cancel). Each run cancels and
# refunds every Pending order that has passed its 24h deadline.
#
# SCHEDULED EXTERNALLY. There is no vercel.json cron any more (Vercel's Hobby
# plan caps cron at once per day and rejects the deployment otherwise). Point
# cron-job.org, GitHub Actions, UptimeRobot or any scheduler at:
#
#   POST https://<your-domain>/api/cron/auto-cancel
#   Header: Authorization: Bearer <CRON_SECRET>
#
# GET works too, for schedulers that only offer GET. Hourly is a sensible
# cadence; the sweep is safe at any frequency, including concurrent runs.
#
# REQUIRED — with this unset the endpoint refuses EVERY request with 401 and
# Pending orders are never cancelled. There is no unauthenticated fallback.
# Use a random string of 16+ characters, and set it in the HOSTING project's
# environment (a local .env is never deployed). `?secret=<value>` is accepted
# as a weaker fallback for schedulers that cannot send headers.
#
# Also run supabase/sql/39_auto_cancel_sweep.sql — without it the sweep still
# works, but falls back to per-order claims instead of the transactional batch.
CRON_SECRET=
